#!/bin/bash
# Runs one of Sparkle's command line tools (generate_keys, sign_update, …) from the
# Swift package checkout, resolving the package first if needed.
set -euo pipefail
cd "$(dirname "$0")/.."
TOOL="${1:?usage: scripts/sparkle-tool <generate_keys|sign_update|…> [args]}"
shift
BIN=.build/artifacts/sparkle/Sparkle/bin
[ -x "$BIN/$TOOL" ] || DEVELOPER_DIR="${DEVELOPER_DIR:-/Applications/Xcode.app/Contents/Developer}" swift package resolve >/dev/null
exec "$BIN/$TOOL" "$@"
